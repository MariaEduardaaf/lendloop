# Copy the Next.js block to .env.local, the Convex block into the Convex deployment
# (npx convex env set NAME value), and the docker-compose block to .env.
# Generate each secret with: openssl rand -hex 32

# --- .env.local (Next.js) ---

# Convex deployment name, written by `npx convex dev`.
CONVEX_DEPLOYMENT=
# Convex client URL, written by `npx convex dev` (http://127.0.0.1:3210 for a local deployment).
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL, written by `npx convex dev` (http://127.0.0.1:3211 locally). n8n calls this one.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk publishable key (Clerk dashboard, API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (server only, never commit it).
CLERK_SECRET_KEY=

# --- Convex deployment env (npx convex env set) ---

# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev. Needs Clerk's Convex integration (see README).
CLERK_JWT_ISSUER_DOMAIN=
# n8n webhook that receives request notifications, e.g. http://localhost:5678/webhook/<path>.
N8N_REQUEST_WEBHOOK_URL=
# Secret used to sign payloads Convex sends to n8n. Must equal the value in docker-compose .env.
CONVEX_TO_N8N_SECRET=
# Secret n8n uses to sign calls to the Convex HTTP endpoints. Must equal the value in docker-compose .env.
N8N_TO_CONVEX_SECRET=

# --- .env (docker-compose, gitignored) ---

# Same value as the Convex env variable of the same name.
CONVEX_TO_N8N_SECRET=
# Same value as the Convex env variable of the same name.
N8N_TO_CONVEX_SECRET=
# Convex HTTP actions URL as n8n sees it (http://host.docker.internal:3211 for a local deployment).
CONVEX_SITE_URL=
# Key n8n uses to encrypt its stored credentials. Keep it stable, losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=
# Optional. Time zone of the daily 09:00 reminder run (defaults to Europe/Madrid).
GENERIC_TIMEZONE=
